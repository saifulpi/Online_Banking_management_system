@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="mx-auto max-w-md">
    <div class="rounded-lg bg-white p-8 shadow">
        <div class="text-center">
            <span class="text-3xl">🏦</span>
            <h1 class="mt-2 text-xl font-bold text-slate-900">Welcome Back</h1>
            <p class="mt-1 text-sm text-slate-600">Login to your online banking account</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="mt-4 rounded-md bg-red-50 p-4 border border-red-200">
                <div asp-validation-summary="All" class="text-sm text-red-700"></div>
            </div>
        }

        <form asp-action="Login" method="post" class="mt-6 space-y-5">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div>
                <label asp-for="MobileNumber" class="block text-sm font-medium text-slate-700">Mobile Number</label>
                <input asp-for="MobileNumber" inputmode="numeric" placeholder="01XXXXXXXXX" autocomplete="off"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="MobileNumber" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700">Password</label>
                <input asp-for="Password" autocomplete="current-password"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="Password" class="text-sm text-red-600"></span>
            </div>
            <div class="flex items-center justify-between">
                <label class="flex items-center">
                    <input asp-for="RememberMe" type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                    <span class="ml-2 text-sm text-slate-600">Remember me</span>
                </label>
            </div>
            <div>
                <button type="submit"
                        class="w-full rounded-md bg-emerald-600 py-2 text-sm font-medium text-white hover:bg-emerald-700">
                    Login
                </button>
            </div>
        </form>
        <p class="mt-4 text-center text-sm text-slate-600">
            Don't have an account?
            <a asp-action="Signup" class="font-medium text-emerald-700 hover:underline">Sign up here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}