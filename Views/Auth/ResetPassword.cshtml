@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    var sentMessage = TempData["ForgotMessage"] as string;
    var hasValidationErrors = !ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0;
}

<div class="login-page">
    <div class="mx-auto mt-6 mb-10 max-w-md">
        <div class="overflow-hidden rounded-3xl border border-bank-200/60 bg-white shadow-xl shadow-bank-900/5">
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10">
                <div class="mb-8 flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-bank-500 to-bank-700 shadow-md shadow-bank-600/20">
                        <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <span class="text-2xl font-bold tracking-tight text-slate-800">Online <span class="text-bank-600">Bank</span></span>
                </div>

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">Verify &amp; Reset</h1>
                <p class="mt-2 text-base text-slate-500">Enter the 6-digit code and your new password.</p>

                @if (!string.IsNullOrEmpty(sentMessage))
                {
                    <div class="mt-5 rounded-xl bg-emerald-50 p-4 border border-emerald-200">
                        <p class="text-sm text-emerald-800">@sentMessage</p>
                    </div>
                }
                @if (string.IsNullOrEmpty(sentMessage) && hasValidationErrors == false)
                {
                    <div class="mt-5 rounded-xl bg-slate-50 p-4 border border-slate-200">
                        <p class="text-sm text-slate-600">A verification code has been sent to your email. It expires in 5 minutes.</p>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="mt-5 rounded-xl bg-red-50 p-4 border border-red-200">
                        <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post" class="mt-8 space-y-5">
                    <input type="hidden" asp-for="Email" />

                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Email</label>
                        <input type="text" value="@Model.Email" readonly
                               class="mt-2 w-full rounded-xl border-bank-200 bg-slate-50 py-3 px-4 text-sm text-slate-500" />
                    </div>

                    <div>
                        <label asp-for="Code" class="block text-sm font-semibold text-slate-700">Verification Code</label>
                        <div class="mt-2 relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                            </div>
                            <input asp-for="Code" inputmode="numeric" maxlength="6" placeholder="6-digit code" autocomplete="one-time-code"
                                   class="login-input w-full rounded-xl border-bank-200 bg-slate-50/50 py-3 pl-12 pr-4 text-center text-lg font-semibold tracking-widest text-slate-900 placeholder:text-sm placeholder:font-normal placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                        </div>
                        <span asp-validation-for="Code" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="block text-sm font-semibold text-slate-700">New Password</label>
                        <div class="mt-2 relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </div>
                            <input asp-for="NewPassword" autocomplete="new-password" id="NewPassword"
                                   class="login-input w-full rounded-xl border-bank-200 bg-slate-50/50 py-3 pl-12 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                        </div>
                        <span asp-validation-for="NewPassword" class="mt-1 block text-sm text-red-600"></span>
                        <div id="passwordChecklist" class="mt-3 space-y-1.5">
                            <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="length">
                                <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                Minimum 6 characters
                            </div>
                            <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="upper">
                                <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                At least one uppercase letter
                            </div>
                            <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="lower">
                                <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                At least one lowercase letter
                            </div>
                            <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="number">
                                <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                At least one number
                            </div>
                            <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="special">
                                <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                At least one special character
                            </div>
                        </div>
                    </div>

                    <div>
                        <label asp-for="ConfirmNewPassword" class="block text-sm font-semibold text-slate-700">Confirm New Password</label>
                        <div class="mt-2 relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </div>
                            <input asp-for="ConfirmNewPassword" autocomplete="new-password"
                                   class="login-input w-full rounded-xl border-bank-200 bg-slate-50/50 py-3 pl-12 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <button type="submit"
                                class="w-full rounded-xl bg-bank-600 py-3.5 text-sm font-bold text-white shadow-md shadow-bank-600/20 transition-colors hover:bg-bank-700 focus:outline-none focus:ring-2 focus:ring-bank-500 focus:ring-offset-2">
                            Reset Password
                        </button>
                    </div>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    You can
                    <a asp-action="ForgotPassword" class="font-semibold text-bank-600 hover:text-bank-700 hover:underline">request a new code</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live password strength checklist. Updates in real time while the user types.
        (function () {
            var input = document.getElementById("NewPassword");
            if (!input) return;

            var rules = {
                length:  /.{6,}/,
                upper:   /[A-Z]/,
                lower:   /[a-z]/,
                number:  /[0-9]/,
                special: /[^A-Za-z0-9]/
            };

            var checkSvg = '<svg class="h-3 w-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>';

            function render() {
                var value = input.value;
                var items = document.querySelectorAll(".pw-req");
                items.forEach(function (item) {
                    var rule = item.getAttribute("data-rule");
                    var ok = rules[rule].test(value);
                    var icon = item.querySelector(".pw-icon");

                    if (ok) {
                        item.classList.remove("text-slate-400");
                        item.classList.add("text-emerald-600");
                        icon.classList.remove("border-slate-300", "bg-white");
                        icon.classList.add("border-emerald-500", "bg-emerald-500");
                        icon.innerHTML = checkSvg;
                    } else {
                        item.classList.remove("text-emerald-600");
                        item.classList.add("text-slate-400");
                        icon.classList.remove("border-emerald-500", "bg-emerald-500");
                        icon.classList.add("border-slate-300", "bg-white");
                        icon.textContent = "";
                    }
                });
            }

            input.addEventListener("input", render);
            render();
        })();
    </script>
}