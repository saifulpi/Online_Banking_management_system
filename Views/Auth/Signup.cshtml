@model SignupViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="mx-auto mt-6 mb-10 max-w-5xl lg:max-w-6xl">
        <div class="overflow-hidden rounded-3xl border border-bank-200/60 bg-white shadow-xl shadow-bank-900/5 lg:min-h-[680px]">
            <div class="grid lg:grid-cols-[55%_45%]">
                <!-- Left column: Registration form -->
                <div class="flex flex-col justify-center px-6 py-10 sm:px-10 lg:px-14 lg:py-16">
                    <div class="mb-8">
                        <div class="flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-bank-500 to-bank-700 shadow-md shadow-bank-600/20">
                                <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 21h18M5 21V7l7-4 7 4v14M9 9v9M15 9v9" />
                                </svg>
                            </span>
                            <span class="text-2xl font-bold tracking-tight text-slate-800">Online <span class="text-bank-600">Bank</span></span>
                        </div>
                    </div>

                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Create Your Account</h1>
                    <p class="mt-2 text-base text-slate-500">Register securely to access your online banking account.</p>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="mt-5 rounded-xl bg-red-50 p-4 border border-red-200">
                            <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                        </div>
                    }

                    <form asp-action="Signup" method="post" class="mt-8 space-y-5">
                        <div>
                            <label asp-for="AccountNumber" class="block text-sm font-semibold text-slate-700">Account Number</label>
                            <input asp-for="AccountNumber" maxlength="8" inputmode="numeric" placeholder="8-digit account number" autocomplete="off"
                                   class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                            <span asp-validation-for="AccountNumber" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="MobileNumber" class="block text-sm font-semibold text-slate-700">Mobile Number</label>
                            <input asp-for="MobileNumber" maxlength="11" inputmode="numeric" placeholder="01XXXXXXXXX" autocomplete="off"
                                   class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                            <span asp-validation-for="MobileNumber" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="Email" class="block text-sm font-semibold text-slate-700">Email Address</label>
                            <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="off"
                                   class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                            <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                            <div>
                                <label asp-for="FirstName" class="block text-sm font-semibold text-slate-700">First Name</label>
                                <input asp-for="FirstName" autocomplete="off"
                                       class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                                <span asp-validation-for="FirstName" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="LastName" class="block text-sm font-semibold text-slate-700">Last Name</label>
                                <input asp-for="LastName" autocomplete="off"
                                       class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                                <span asp-validation-for="LastName" class="mt-1 block text-sm text-red-600"></span>
                            </div>
                        </div>
                        <div>
                            <label asp-for="Password" class="block text-sm font-semibold text-slate-700">Set Password</label>
                            <input asp-for="Password" autocomplete="new-password" id="Password"
                                   class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                            <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
                            <div id="passwordChecklist" class="mt-3 space-y-1.5">
                                <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="length">
                                    <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                    Minimum 6 characters
                                </div>
                                <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="upper">
                                    <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                    At least one uppercase letter
                                </div>
                                <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="lower">
                                    <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                    At least one lowercase letter
                                </div>
                                <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="number">
                                    <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                    At least one number
                                </div>
                                <div class="pw-req flex items-center gap-2 text-xs text-slate-400 transition-colors duration-150" data-rule="special">
                                    <span class="pw-icon flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 transition-colors duration-150" aria-hidden="true"></span>
                                    At least one special character
                                </div>
                            </div>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-slate-700">Confirm Password</label>
                            <input asp-for="ConfirmPassword" autocomplete="new-password"
                                   class="login-input mt-2 w-full rounded-xl border-bank-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                            <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <button type="submit"
                                    class="w-full rounded-xl bg-bank-600 py-3.5 text-sm font-bold text-white shadow-md shadow-bank-600/20 transition-colors hover:bg-bank-700 focus:outline-none focus:ring-2 focus:ring-bank-500 focus:ring-offset-2">
                                Sign Up
                            </button>
                        </div>
                    </form>
                    <p class="mt-6 text-center text-sm text-slate-500">
                        Already have an account?
                        <a asp-action="Login" class="font-semibold text-bank-600 hover:text-bank-700 hover:underline">Login here</a>
                    </p>

                    <div class="mt-8 flex items-center justify-center gap-4 text-slate-300">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <span class="text-xs font-medium tracking-wide text-slate-400">Encrypted &amp; Protected</span>
                    </div>
                </div>

                <!-- Right column: Decorative banking illustration -->
                <div class="relative hidden overflow-hidden bg-gradient-to-br from-bank-50 via-sky-50 to-cyan-50 p-8 sm:p-10 lg:flex lg:flex-col lg:justify-center lg:p-12">
                    <!-- Decorative soft shapes -->
                    <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-bank-200/40 blur-3xl" aria-hidden="true"></div>
                    <div class="absolute -bottom-20 -left-10 h-72 w-72 rounded-full bg-sky-200/40 blur-3xl" aria-hidden="true"></div>

                    <div class="relative z-10 mx-auto w-full max-w-sm">
                        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Your Future, <span class="text-bank-600">Secured</span></h2>
                        <p class="mt-2 text-sm font-medium text-slate-500">Simple. Secure. Always Yours.</p>

                        <!-- Security message card -->
                        <div class="mt-8 rounded-2xl bg-gradient-to-br from-bank-600 to-bank-800 p-6 shadow-lg shadow-bank-800/25">
                            <div class="flex items-start justify-between">
                                <div>
                                    <p class="text-lg font-semibold leading-snug text-white">Your finances,<br />protected.</p>
                                    <p class="mt-1.5 text-sm text-bank-100/80">Simple. Secure. Always Yours.</p>
                                </div>
                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15">
                                    <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    </svg>
                                </span>
                            </div>
                            <div class="mt-4 inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5">
                                <svg class="h-4 w-4 text-bank-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                                <span class="text-xs font-semibold text-white">Secure &amp; Encrypted</span>
                            </div>
                        </div>

                        <!-- Stat cards -->
                        <div class="mt-6 grid grid-cols-2 gap-4">
                            <div class="rounded-2xl bg-white/80 p-5 shadow-sm ring-1 ring-bank-100">
                                <div class="flex items-center gap-1.5">
                                    <svg class="h-4 w-4 text-bank-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    </svg>
                                    <p class="text-xs font-semibold text-slate-500">Secured</p>
                                </div>
                                <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
                                    <div class="h-full w-4/5 rounded-full bg-bank-500"></div>
                                </div>
                            </div>
                            <div class="rounded-2xl bg-white/80 p-5 shadow-sm ring-1 ring-bank-100">
                                <p class="text-xs font-semibold text-slate-500">Private</p>
                                <div class="mt-3 flex items-center justify-center">
                                    <div class="donut" aria-hidden="true"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Chart -->
                        <div class="mt-4 rounded-2xl bg-white/85 p-5 shadow-sm ring-1 ring-bank-100">
                            <div class="flex items-center gap-2">
                                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-emerald-100">
                                    <svg class="h-4 w-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                </span>
                                <p class="text-xs font-semibold text-slate-500">Protected</p>
                            </div>
                            <div class="mt-4 flex h-16 items-end gap-2" aria-hidden="true">
                                <div class="bar-child flex-1 rounded-t-md bg-bank-100"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-200"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-300"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-400"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-500"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-400"></div>
                                <div class="bar-child flex-1 rounded-t-md bg-bank-300"></div>
                            </div>
                        </div>

                        <!-- Security & notification cards -->
                        <div class="mt-4 space-y-3">
                            <div class="flex items-center gap-3 rounded-xl bg-white/85 p-3.5 shadow-sm ring-1 ring-bank-100">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-bank-100">
                                    <svg class="h-5 w-5 text-bank-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    </svg>
                                </span>
                                <span class="text-sm font-semibold text-slate-700">Secure &amp; Protected</span>
                            </div>
                            <div class="flex items-center gap-3 rounded-xl bg-white/85 p-3.5 shadow-sm ring-1 ring-bank-100">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-100">
                                    <svg class="h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                </span>
                                <span class="text-sm font-semibold text-slate-700">Account setup ready</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile decorative summary (shown below form on small screens) -->
        <div class="relative mt-6 overflow-hidden rounded-3xl bg-gradient-to-br from-bank-50 via-sky-50 to-cyan-50 p-6 lg:hidden">
            <div class="absolute -top-10 -right-10 h-40 w-40 rounded-full bg-bank-200/40 blur-2xl" aria-hidden="true"></div>
            <div class="relative z-10">
                <h2 class="text-xl font-bold text-slate-900">Your Future, <span class="text-bank-600">Secured</span></h2>
                <p class="mt-1 text-sm text-slate-500">Simple. Secure. Always Yours.</p>
                <div class="mt-5 rounded-2xl bg-gradient-to-br from-bank-600 to-bank-800 p-5 shadow-lg">
                    <p class="text-base font-semibold text-white">Your finances, protected.</p>
                    <p class="mt-1 text-sm text-bank-100/80">Simple. Secure. Always Yours.</p>
                    <div class="mt-3 inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5">
                        <svg class="h-4 w-4 text-bank-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <span class="text-xs font-semibold text-white">Secure &amp; Encrypted</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-white/70 px-4 py-3 text-bank-700 ring-1 ring-bank-100">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    <span class="text-xs font-semibold">Encrypted &amp; Protected</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live password strength checklist. Updates in real time while the user types.
        (function () {
            var input = document.getElementById("Password");
            if (!input) return;

            var rules = {
                length:  /.{6,}/,
                upper:   /[A-Z]/,
                lower:   /[a-z]/,
                number:  /[0-9]/,
                special: /[^A-Za-z0-9]/
            };

            var checkSvg = '<svg class="h-3 w-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>';

            function render() {
                var value = input.value;
                var items = document.querySelectorAll(".pw-req");
                items.forEach(function (item) {
                    var rule = item.getAttribute("data-rule");
                    var ok = rules[rule].test(value);
                    var icon = item.querySelector(".pw-icon");

                    if (ok) {
                        item.classList.remove("text-slate-400");
                        item.classList.add("text-emerald-600");
                        icon.classList.remove("border-slate-300", "bg-white");
                        icon.classList.add("border-emerald-500", "bg-emerald-500");
                        icon.innerHTML = checkSvg;
                    } else {
                        item.classList.remove("text-emerald-600");
                        item.classList.add("text-slate-400");
                        icon.classList.remove("border-emerald-500", "bg-emerald-500");
                        icon.classList.add("border-slate-300", "bg-white");
                        icon.textContent = "";
                    }
                });
            }

            input.addEventListener("input", render);
            render();
        })();
    </script>
}
