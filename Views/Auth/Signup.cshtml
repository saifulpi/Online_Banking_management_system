@model SignupViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}

<div class="mx-auto max-w-lg">
    <div class="rounded-lg bg-white p-8 shadow">
        <div class="text-center">
            <span class="text-3xl">🏦</span>
            <h1 class="mt-2 text-2xl font-bold text-slate-900">Create Your Account</h1>
            <p class="mt-1 text-sm text-slate-600">Register to get access to your online banking portal.</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="mt-4 rounded-md bg-red-50 p-4 border border-red-200">
                <div class="ml-3">
                    <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                </div>
            </div>
        }

        <form asp-action="Signup" method="post" class="mt-6 space-y-5">
            <div>
                <label asp-for="AccountNumber" class="block text-sm font-medium text-slate-700">Account Number</label>
                <input asp-for="AccountNumber" maxlength="8" inputmode="numeric" placeholder="8-digit account number" autocomplete="off"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="AccountNumber" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="MobileNumber" class="block text-sm font-medium text-slate-700">Mobile Number</label>
                <input asp-for="MobileNumber" maxlength="11" inputmode="numeric" placeholder="01XXXXXXXXX" autocomplete="off"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="MobileNumber" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email Address</label>
                <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="off"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="Email" class="text-sm text-red-600"></span>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-slate-700">First Name</label>
                    <input asp-for="FirstName" autocomplete="off"
                           class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                    <span asp-validation-for="FirstName" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-slate-700">Last Name</label>
                    <input asp-for="LastName" autocomplete="off"
                           class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                    <span asp-validation-for="LastName" class="text-sm text-red-600"></span>
                </div>
            </div>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700">Set Password</label>
                <input asp-for="Password" autocomplete="new-password"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="Password" class="text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700">Confirm Password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600"></span>
            </div>
            <div>
                <button type="submit"
                        class="w-full rounded-md bg-emerald-600 py-2 text-sm font-medium text-white hover:bg-emerald-700">
                    Sign Up
                </button>
            </div>
        </form>
        <p class="mt-4 text-center text-sm text-slate-600">
            Already have an account?
            <a asp-action="Login" class="font-medium text-emerald-700 hover:underline">Login here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}