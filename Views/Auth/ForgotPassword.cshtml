@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page">
    <div class="mx-auto mt-6 mb-10 max-w-md">
        <div class="overflow-hidden rounded-3xl border border-bank-200/60 bg-white shadow-xl shadow-bank-900/5">
            <div class="flex flex-col justify-center px-6 py-10 sm:px-10">
                <div class="mb-8 flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-bank-500 to-bank-700 shadow-md shadow-bank-600/20">
                        <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <span class="text-2xl font-bold tracking-tight text-slate-800">Online <span class="text-bank-600">Bank</span></span>
                </div>

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">Forgot Password</h1>
                <p class="mt-2 text-base text-slate-500">Enter your registered email and phone number to receive a verification code.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="mt-5 rounded-xl bg-red-50 p-4 border border-red-200">
                        <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post" class="mt-8 space-y-5">
                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-700">Email</label>
                        <div class="mt-2 relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="2" y="4" width="20" height="16" rx="2" />
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                </svg>
                            </div>
                            <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com"
                                   class="login-input w-full rounded-xl border-bank-200 bg-slate-50/50 py-3 pl-12 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                        </div>
                        <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="MobileNumber" class="block text-sm font-semibold text-slate-700">Registered Phone Number</label>
                        <div class="mt-2 relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="6" y="2" width="12" height="20" rx="2" />
                                    <path d="M11 18h2" />
                                </svg>
                            </div>
                            <input asp-for="MobileNumber" inputmode="numeric" placeholder="01XXXXXXXXX" autocomplete="tel"
                                   class="login-input w-full rounded-xl border-bank-200 bg-slate-50/50 py-3 pl-12 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-bank-400 focus:bg-white focus:ring-bank-400/30" />
                        </div>
                        <span asp-validation-for="MobileNumber" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <button type="submit"
                                class="w-full rounded-xl bg-bank-600 py-3.5 text-sm font-bold text-white shadow-md shadow-bank-600/20 transition-colors hover:bg-bank-700 focus:outline-none focus:ring-2 focus:ring-bank-500 focus:ring-offset-2">
                            Send Verification Code
                        </button>
                    </div>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    Remembered your password?
                    <a asp-action="Login" class="font-semibold text-bank-600 hover:text-bank-700 hover:underline">Back to Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}