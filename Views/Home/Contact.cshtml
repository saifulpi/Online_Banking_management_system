@{
    ViewData["Title"] = "Contact Us";
}

<div class="lg:min-h-[600px]">
    <!-- Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-bank-600 to-bank-900 px-6 py-10 sm:px-10 sm:py-14">
        <div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -bottom-20 -left-10 h-72 w-72 rounded-full bg-sky-300/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative z-10 max-w-2xl">
            <span class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-bank-100">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
                We're here to help
            </span>
            <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Contact Us</h1>
            <p class="mt-3 max-w-xl text-base text-bank-100/90">
                Questions about your account, a transaction, or our services? Our team is here to support you. Reach out and we'll respond as soon as possible.
            </p>
        </div>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <!-- Email card -->
        <a href="mailto:bankmanagementsio@gmail.com"
           class="group flex flex-col rounded-2xl border border-bank-200/60 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-bank-50 text-bank-600 transition-colors group-hover:bg-bank-600 group-hover:text-white">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
            </span>
            <h2 class="mt-4 text-lg font-semibold text-slate-900">Email Us</h2>
            <p class="mt-1 text-sm text-slate-500">For account inquiries and support, email our team anytime.</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-bank-600 group-hover:text-bank-700">
                bankmanagementsio@gmail.com
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </span>
        </a>

        <!-- Phone card -->
        <a href="tel:+8801XXXXXXXXX"
           class="group flex flex-col rounded-2xl border border-bank-200/60 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-bank-50 text-bank-600 transition-colors group-hover:bg-bank-600 group-hover:text-white">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="6" y="2" width="12" height="20" rx="2" />
                    <path d="M11 18h2" />
                </svg>
            </span>
            <h2 class="mt-4 text-lg font-semibold text-slate-900">Call Us</h2>
            <p class="mt-1 text-sm text-slate-500">Prefer to talk? Our support line is available for your convenience.</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-bank-600 group-hover:text-bank-700">
                +880 1XXX-XXXXXX
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </span>
        </a>

        <!-- Support hours card -->
        <div class="flex flex-col rounded-2xl border border-bank-200/60 bg-white p-6 shadow-sm">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-bank-50 text-bank-600">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                </svg>
            </span>
            <h2 class="mt-4 text-lg font-semibold text-slate-900">Support Hours</h2>
            <p class="mt-1 text-sm text-slate-500">Our team is available during the following hours:</p>
            <div class="mt-3 space-y-1 text-sm text-slate-600">
                <div class="flex items-center justify-between">
                    <span>Sunday - Thursday</span>
                    <span class="font-medium text-slate-800">9:00 AM - 6:00 PM</span>
                </div>
                <div class="flex items-center justify-between">
                    <span>Friday - Saturday</span>
                    <span class="font-medium text-slate-800">9:00 AM - 3:00 PM</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Social media -->
    <div class="mt-10 rounded-2xl border border-bank-200/60 bg-white p-6 shadow-sm sm:p-8">
        <div class="sm:flex sm:items-center sm:justify-between">
            <div>
                <h2 class="text-xl font-bold tracking-tight text-slate-900">Follow Us</h2>
                <p class="mt-1 text-sm text-slate-500">Stay updated with the latest news and offers across our social channels.</p>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-3 sm:mt-0 sm:flex sm:gap-3">
                <!-- Facebook (placeholder link) -->
                <a href="#" aria-label="Facebook"
                   class="inline-flex items-center gap-2 rounded-xl border border-bank-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-bank-400 hover:bg-bank-50 hover:text-bank-700">
                    <svg class="h-5 w-5 text-bank-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
                    </svg>
                    Facebook
                </a>
                <!-- LinkedIn (placeholder link) -->
                <a href="#" aria-label="LinkedIn"
                   class="inline-flex items-center gap-2 rounded-xl border border-bank-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-bank-400 hover:bg-bank-50 hover:text-bank-700">
                    <svg class="h-5 w-5 text-bank-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M19 3A2 2 0 0 1 21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.5 18V9H6v9h2.5zm-1.25-10.25a1.44 1.44 0 1 0 0-2.87 1.44 1.44 0 0 0 0 2.87zM18 13.85c0-2.44-1.3-3.57-3.04-3.57-.97 0-1.66.48-2.16 1.13V9H10.2v9h2.6v-4.77c0-.6.1-1.19.86-1.19.74 0 1.04.55 1.04 1.2V18h2.5v-4.15z" />
                    </svg>
                    LinkedIn
                </a>
                <!-- GitHub (placeholder link) -->
                <a href="#" aria-label="GitHub"
                   class="inline-flex items-center gap-2 rounded-xl border border-bank-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-bank-400 hover:bg-bank-50 hover:text-bank-700">
                    <svg class="h-5 w-5 text-bank-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1.01.07 1.54 1.04 1.54 1.04.9 1.54 2.36 1.1 2.94.84.09-.65.35-1.1.63-1.35-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.57 9.57 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48C19.14 20.17 22 16.42 22 12c0-5.52-4.48-10-10-10z" />
                    </svg>
                    GitHub
                </a>
                <!-- Instagram (placeholder link) -->
                <a href="#" aria-label="Instagram"
                   class="inline-flex items-center gap-2 rounded-xl border border-bank-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-bank-400 hover:bg-bank-50 hover:text-bank-700">
                    <svg class="h-5 w-5 text-bank-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </svg>
                    Instagram
                </a>
            </div>
        </div>
    </div>

    <!-- Note -->
    <p class="mt-8 text-center text-sm text-slate-500">
        Social media links will be added soon. For urgent matters, please use Email or Phone.
    </p>
</div>