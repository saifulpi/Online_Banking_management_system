@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-8">
    <div class="text-center py-6">
        <h1 class="text-3xl font-extrabold text-slate-900">Welcome, @Model.UserName</h1>
        <p class="mt-2 text-lg text-slate-600">
            @if (Model.IsAdmin)
            {
                <span>Online Banking Management System - Admin Panel</span>
            }
            else
            {
                <span>Manage your account securely with Online Bank.</span>
            }
        </p>
    </div>

    @if (Model.IsAdmin)
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="rounded-lg bg-gradient-to-br from-emerald-600 to-teal-600 p-6 shadow-lg">
                <p class="text-sm font-medium text-emerald-100">Total Accounts</p>
                <p class="mt-2 text-4xl font-bold text-white">@Model.TotalAccounts</p>
            </div>
            <div class="rounded-lg bg-gradient-to-br from-blue-600 to-indigo-600 p-6 shadow-lg">
                <p class="text-sm font-medium text-blue-100">Total Balance</p>
                <p class="mt-2 text-4xl font-bold text-white">@Model.TotalBalance.ToString("C")</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="rounded-lg bg-white p-6 shadow">
                <h2 class="text-lg font-semibold text-slate-900">Quick Actions</h2>
                <div class="mt-4 space-y-3">
                    <a asp-controller="Account" asp-action="Create"
                       class="block rounded-md bg-emerald-600 px-4 py-3 text-center text-sm font-medium text-white hover:bg-emerald-700">Open New Account</a>
                    <a asp-controller="Account" asp-action="Users"
                       class="block rounded-md bg-purple-600 px-4 py-3 text-center text-sm font-medium text-white hover:bg-purple-700">Manage Users</a>
                    <a asp-controller="Account" asp-action="Deposit"
                       class="block rounded-md bg-blue-600 px-4 py-3 text-center text-sm font-medium text-white hover:bg-blue-700">Deposit Money</a>
                    <a asp-controller="Account" asp-action="Withdraw"
                       class="block rounded-md bg-amber-500 px-4 py-3 text-center text-sm font-medium text-white hover:bg-amber-600">Withdraw Money</a>
                    <a asp-controller="Account" asp-action="Transfer"
                       class="block rounded-md bg-indigo-600 px-4 py-3 text-center text-sm font-medium text-white hover:bg-indigo-700">Transfer Money</a>
                </div>
            </div>

            <div class="rounded-lg bg-white p-6 shadow lg:col-span-2">
                <h2 class="text-lg font-semibold text-slate-900">Recent Accounts</h2>
                @if (Model.RecentAccounts.Any())
                {
                    <div class="mt-4 overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account No</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Name</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Phone</th>
                                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Balance</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200">
                                @foreach (var account in Model.RecentAccounts)
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="px-4 py-3 text-sm font-medium text-slate-900">
                                            <a asp-controller="Account" asp-action="Details" asp-route-accountNumber="@account.AccountNumber"
                                               class="text-emerald-700 hover:underline">@account.AccountNumber</a>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-slate-700">@account.Name</td>
                                        <td class="px-4 py-3 text-sm text-slate-700">@account.PhoneNumber</td>
                                        <td class="px-4 py-3 text-right text-sm font-semibold text-slate-900">@account.Balance.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mt-4 text-sm text-slate-500">No accounts yet. <a asp-controller="Account" asp-action="Create" class="text-emerald-700 hover:underline">Create the first account.</a></p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="rounded-lg bg-white p-8 shadow">
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-xl font-semibold text-slate-900">@(Model.CurrentUser?.FullName ?? Model.UserName)</h2>
                    <p class="mt-1 text-sm text-slate-600">Account No: <span class="font-semibold">@Model.CurrentUser?.AccountNumber</span></p>
                    <p class="mt-1 text-sm text-slate-600">Mobile: @Model.CurrentUser?.MobileNumber</p>
                    <p class="mt-1 text-sm text-slate-600">Email: @Model.CurrentUser?.Email</p>
                </div>
                <div class="text-right">
                    <p class="text-sm text-slate-500">Current Balance</p>
                    @if (Model.MyAccount != null)
                    {
                        <p class="text-3xl font-bold text-emerald-600">@Model.MyAccount.Balance.ToString("C")</p>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 mt-2">No account found for this number.</p>
                    }
                </div>
            </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-slate-900">Recent Transactions</h2>
                <a asp-controller="Account" asp-action="History"
                   class="text-sm text-emerald-700 hover:underline">View all</a>
            </div>
            @if (Model.RecentTransactions.Any())
            {
                <div class="mt-4 space-y-3">
                    @foreach (var t in Model.RecentTransactions)
                    {
                        <div class="flex items-center justify-between rounded-md border border-slate-200 px-4 py-3">
                            <div>
                                <p class="text-sm font-medium text-slate-900">
                                    @if (t.Type == TransactionType.Deposit) { <span class="text-emerald-600">Deposit</span> }
                                    else if (t.Type == TransactionType.Withdrawal) { <span class="text-red-600">Withdrawal</span> }
                                    else { <span class="text-indigo-600">Transfer</span> }
                                </p>
                                <p class="text-xs text-slate-500">@t.Date.ToLocalTime().ToString("g")</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-semibold text-slate-900">@t.Amount.ToString("C")</p>
                                <p class="text-xs text-slate-500">Balance: @t.BalanceAfter.ToString("C")</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="mt-4 text-sm text-slate-500">No transactions yet.</p>
            }
        </div>
    }
</div>
