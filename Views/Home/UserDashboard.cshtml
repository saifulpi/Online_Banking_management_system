@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="space-y-8">
    <!-- Welcome -->
    <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[#07865F]">Welcome Back</p>
        <h1 class="mt-1.5 text-3xl font-extrabold tracking-tight text-[#172033] sm:text-4xl">@Model.CurrentUser?.FullName</h1>
        <p class="mt-2.5 inline-flex items-center rounded-full ring-1 ring-slate-200 ring-inset bg-white px-3.5 py-1.5">
            <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Account No.</span>
            <span class="ml-2 text-base font-bold tracking-tight text-[#07865F]">@Model.MyAccount?.AccountNumber</span>
        </p>
    </div>

    <!-- Statistics / Summary -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 xl:grid-cols-[1fr_1fr_1.25fr_1fr] xl:gap-5">
        <!-- Current Balance — visually prominent, first on mobile -->
        <div class="order-first rounded-2xl border border-slate-200 bg-white px-5 py-6 shadow-[0_4px_15px_rgba(15,23,42,0.04)] transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)] xl:row-span-1">
            <div class="flex h-10 items-center justify-between">
                <p class="text-sm font-medium leading-10 text-slate-500">Current Balance</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50">
                    <svg class="h-5 w-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="5" width="20" height="14" rx="2" />
                        <path d="M2 10h20" />
                    </svg>
                </span>
            </div>
            <p class="mt-4 text-[1.75rem] font-bold leading-tight tracking-tight text-indigo-600">@(Model.MyAccount?.Balance.ToString("C") ?? "-")</p>
            <p class="mt-1.5 text-xs text-slate-400">Available balance</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-6 shadow-[0_4px_15px_rgba(15,23,42,0.04)] transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
            <div class="flex h-10 items-center justify-between">
                <p class="text-sm font-medium leading-10 text-slate-500">Total Deposit</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50">
                    <svg class="h-5 w-5 text-[#0F9D6E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                        <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                        <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
                    </svg>
                </span>
            </div>
            <p class="mt-4 text-2xl font-bold tracking-tight text-[#0F9D6E]">@Model.TotalDeposit.ToString("C")</p>
            <p class="mt-1.5 text-xs text-slate-400">Money deposited into this account</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-6 shadow-[0_4px_15px_rgba(15,23,42,0.04)] transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
            <div class="flex h-10 items-center justify-between">
                <p class="text-sm font-medium leading-10 text-slate-500">Total Withdraw</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-red-50">
                    <svg class="h-5 w-5 text-[#DC3545]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                    </svg>
                </span>
            </div>
            <p class="mt-4 text-2xl font-bold tracking-tight text-[#DC3545]">@Model.TotalWithdraw.ToString("C")</p>
            <p class="mt-1.5 text-xs text-slate-400">Money withdrawn or transferred out</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-6 shadow-[0_4px_15px_rgba(15,23,42,0.04)] transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
            <div class="flex h-10 items-center justify-between">
                <p class="text-sm font-medium leading-10 text-slate-500">Recent Activity</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-50">
                    <svg class="h-5 w-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                </span>
            </div>
            <p class="mt-4 text-2xl font-bold tracking-tight text-[#172033]">@Model.TotalTransactions</p>
            <p class="mt-1.5 text-xs text-slate-400">
                @if (Model.LastActivityDate.HasValue)
                {
                    <text>Last activity @Model.LastActivityDate.Value.ToDisplayDateTime()</text>
                }
                else
                {
                    <text>No activity yet</text>
                }
            </p>
        </div>
    </div>

    <!-- Latest Transactions -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_4px_15px_rgba(15,23,42,0.04)] sm:p-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-lg font-semibold tracking-tight text-[#172033] sm:text-xl">Latest Transactions</h2>
            <a asp-controller="Account" asp-action="History"
               class="inline-flex items-center justify-center rounded-lg bg-[#07865F] px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors duration-150 hover:bg-[#056B53]">
                View All Transactions
            </a>
        </div>

        @if (Model.RecentTransactions.Any())
        {
            <div class="mt-5 divide-y divide-slate-100">
                @foreach (var t in Model.RecentTransactions.Take(2))
                {
                    var isDeposit = t.Type == TransactionType.Deposit;
                    var isWithdrawal = t.Type == TransactionType.Withdrawal;
                    var isTransfer = t.Type == TransactionType.Transfer;
                    var received = isTransfer && t.Note.StartsWith("Received", StringComparison.OrdinalIgnoreCase);
                    var direction = isDeposit || received ? "in" : "out";
                    var badgeColor = isDeposit ? "bg-emerald-50 text-[#0F9D6E] ring-emerald-100"
                        : isWithdrawal ? "bg-red-50 text-[#DC3545] ring-red-100"
                        : received ? "bg-teal-50 text-teal-700 ring-teal-100"
                        : "bg-indigo-50 text-indigo-700 ring-indigo-100";
                    var iconBg = direction == "in" ? "bg-emerald-50 text-[#0F9D6E]" : "bg-red-50 text-[#DC3545]";
                    var label = isDeposit ? "Deposit"
                        : isWithdrawal ? "Withdrawal"
                        : received ? "Transfer In"
                        : "Transfer Out";

                    <div class="flex flex-col gap-3 py-5 transition-colors duration-150 hover:bg-slate-50/60 sm:flex-row sm:items-center sm:justify-between sm:px-2 sm:rounded-lg">
                        <div class="flex items-center">
                            <div class="mr-4 flex h-11 w-11 shrink-0 items-center justify-center rounded-full @iconBg">
                                @if (direction == "in")
                                {
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 19V5" />
                                        <path d="m5 12 7 7 7-7" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 5v14" />
                                        <path d="m19 12-7 7-7-7" />
                                    </svg>
                                }
                            </div>
                            <div>
                                <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset @badgeColor">@label</span>
                                <p class="mt-1.5 text-xs text-slate-500">@t.Date.ToDisplayDateTime()</p>
                                <p class="mt-0.5 text-xs text-slate-500">@t.Note</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-between sm:flex-col sm:items-end sm:justify-center">
                            <p class="text-base font-bold @(direction == "in" ? "text-[#0F9D6E]" : "text-[#DC3545]")">
                                @(direction == "in" ? "+" : "-")@t.Amount.ToString("C")
                            </p>
                            <span class="mt-1.5 inline-flex rounded-full px-2 py-0.5 text-xs font-medium
                                @(t.Status == "Completed" ? "bg-green-50 text-[#0F9D6E] ring-1 ring-inset ring-green-100" : "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-100")">
                                @t.Status
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mt-5 rounded-xl border border-dashed border-slate-200 p-10 text-center">
                <p class="text-slate-500">No transactions yet.</p>
                <p class="mt-1 text-sm text-slate-400">Use <a asp-controller="Account" asp-action="Deposit" class="text-[#07865F] hover:underline">Deposit</a> to add money to your account.</p>
            </div>
        }
    </div>
</div>
