@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_DashboardLayout";
}

<div class="mx-auto max-w-2xl space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">My Profile</h1>
        <p class="mt-1 text-sm text-slate-600">Update your personal information below.</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="rounded-md bg-red-50 p-4 border border-red-200">
            <div asp-validation-summary="All" class="text-sm text-red-700"></div>
        </div>
    }

    <div class="rounded-lg bg-white p-6 shadow">
        <form asp-action="Index" method="post" enctype="multipart/form-data" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Profile Picture -->
            <div class="flex flex-col items-center gap-4 rounded-md bg-slate-50 p-4 sm:flex-row sm:items-start">
                <div class="relative">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Profile picture"
                             class="h-24 w-24 rounded-full object-cover ring-4 ring-emerald-100" />
                    }
                    else
                    {
                        <div class="flex h-24 w-24 items-center justify-center rounded-full bg-emerald-600 text-3xl font-bold text-white">
                            @(string.Concat(new[] { Model.FirstName?.FirstOrDefault().ToString() ?? "", Model.LastName?.FirstOrDefault().ToString() ?? "" }))
                        </div>
                    }
                </div>
                <div class="flex-1">
                    <p class="text-sm font-semibold text-slate-800">Profile Picture</p>
                    <p class="mt-1 text-xs text-slate-500">Upload a photo to personalize your account.</p>

                    <input asp-for="ProfilePicture" type="file" accept=".jpg,.jpeg,.png,.webp"
                           class="mt-3 block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-emerald-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-emerald-700" />
                    <span asp-validation-for="ProfilePicture" class="text-sm text-red-600"></span>
                    <p class="mt-1 text-xs text-slate-400">JPG, JPEG, PNG or WEBP — maximum 2 MB.</p>

                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <label class="mt-3 inline-flex items-center text-sm text-red-600 hover:underline">
                            <input asp-for="RemoveProfilePicture" type="checkbox" class="mr-2 h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-500" />
                            Remove current picture
                        </label>
                    }
                </div>
            </div>

            <!-- Read-only banking info -->
            <div class="rounded-md bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Account Information</p>
                <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Account Number</label>
                        <input value="@Model.AccountNumber" readonly
                               class="mt-1 block w-full rounded-md border-slate-300 bg-slate-100 px-3 py-2 text-slate-500 sm:text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Role</label>
                        <input value="@Model.Role" readonly
                               class="mt-1 block w-full rounded-md border-slate-300 bg-slate-100 px-3 py-2 text-slate-500 sm:text-sm" />
                    </div>
                </div>
                <p class="mt-2 text-xs text-slate-400">Account number and role cannot be changed.</p>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-slate-700">First Name</label>
                    <input asp-for="FirstName" autocomplete="off"
                           class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                    <span asp-validation-for="FirstName" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-slate-700">Last Name</label>
                    <input asp-for="LastName" autocomplete="off"
                           class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                    <span asp-validation-for="LastName" class="text-sm text-red-600"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email Address</label>
                <input asp-for="Email" type="email" readonly
                       class="mt-1 block w-full rounded-md border-slate-300 bg-slate-100 px-3 py-2 text-slate-500 sm:text-sm" />
                <p class="mt-1 text-xs text-slate-400">Email address cannot be changed.</p>
            </div>

            <div>
                <label asp-for="MobileNumber" class="block text-sm font-medium text-slate-700">Mobile Number</label>
                <input asp-for="MobileNumber"
                       class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm" />
                <span asp-validation-for="MobileNumber" class="text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Address" class="block text-sm font-medium text-slate-700">Address</label>
                <textarea asp-for="Address" rows="3"
                          class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"></textarea>
                <span asp-validation-for="Address" class="text-sm text-red-600"></span>
            </div>

            <div class="flex items-center justify-end">
                <button type="submit"
                        class="rounded-md bg-emerald-600 px-5 py-2 text-sm font-medium text-white hover:bg-emerald-700">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}