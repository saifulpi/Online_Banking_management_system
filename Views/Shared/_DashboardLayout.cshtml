<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Bank</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-100">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        bool IsActive(string ctrl, string act) =>
            string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
            && string.Equals(action, act, StringComparison.OrdinalIgnoreCase);

        var userFullName = User.Identity?.Name ?? "User";
        var userEmail = User.FindFirstValue("Email") ?? string.Empty;
        var userPictureUrl = User.FindFirstValue("ProfilePictureUrl");
        var userInitials = string.Concat(userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => p[0])).ToUpperInvariant();
    }

    <div class="min-h-full lg:flex">
        <!-- Mobile top bar -->
        <div class="lg:hidden bg-emerald-700 py-3 shadow">
            <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4">
                <a asp-controller="Home" asp-action="Index" class="flex items-center">
                    <span class="text-2xl mr-2">🏦</span>
                    <span class="text-xl font-bold text-white">Online Bank</span>
                </a>
                <button type="button" onclick="document.getElementById('mobileSidebar').classList.toggle('hidden')"
                        class="rounded-md bg-emerald-600 p-2 text-emerald-50 hover:bg-emerald-500">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <aside id="mobileSidebar" class="hidden lg:flex lg:w-72 lg:flex-col lg:fixed lg:inset-y-0 bg-emerald-800 text-emerald-50 shadow-xl z-20">
            <div class="flex h-full flex-col overflow-y-auto">
                <div class="px-6 py-6 flex items-center border-b border-emerald-700">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center">
                        <span class="text-2xl mr-2">🏦</span>
                        <span class="text-xl font-bold text-white">Online Bank</span>
                    </a>
                </div>

                <!-- Profile -->
                <div class="px-6 py-5 border-b border-emerald-700">
                    <div class="flex items-center space-x-3">
                        <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full bg-emerald-500">
                            @if (!string.IsNullOrEmpty(userPictureUrl))
                            {
                                <img src="@userPictureUrl" alt="Profile picture" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <span class="text-sm font-bold text-white">@userInitials</span>
                            }
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-white">@userFullName</p>
                            <p class="truncate text-xs text-emerald-300">@userEmail</p>
                        </div>
                    </div>
                    <a asp-controller="Profile" asp-action="Index"
                       class="mt-3 inline-flex w-full items-center justify-center rounded-md bg-emerald-700 px-3 py-1.5 text-xs font-medium text-emerald-50 hover:bg-emerald-600">
                        Edit Profile
                    </a>
                </div>

                <!-- Navigation -->
                <nav class="flex-1 space-y-1 px-4 py-4">
                    <span class="px-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">Menu</span>

                    <a asp-controller="Home" asp-action="Index"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Home", "Index") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">📊</span> Dashboard
                    </a>
                    <a asp-controller="Profile" asp-action="Index"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Profile", "Index") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">👤</span> Profile
                    </a>
                    <a asp-controller="Account" asp-action="Deposit"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Account", "Deposit") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">💰</span> Deposit
                    </a>
                    <a asp-controller="Account" asp-action="Withdraw"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Account", "Withdraw") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">🏧</span> Withdraw
                    </a>
                    <a asp-controller="Account" asp-action="Transfer"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Account", "Transfer") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">🔁</span> Money Transfer
                    </a>
                    <a asp-controller="Account" asp-action="History"
                       class="flex items-center rounded-md px-3 py-2.5 text-sm font-medium @(IsActive("Account", "History") ? "bg-emerald-700 text-white" : "text-emerald-100 hover:bg-emerald-700 hover:text-white")">
                        <span class="mr-3 text-lg">📜</span> Transaction History
                    </a>
                </nav>

                <!-- Logout -->
                <div class="border-t border-emerald-700 px-4 py-4">
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit"
                                class="flex w-full items-center rounded-md px-3 py-2.5 text-sm font-medium text-red-200 hover:bg-red-900 hover:text-white">
                            <span class="mr-3 text-lg">↪️</span> Logout
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <div class="lg:pl-72 flex flex-col min-h-[calc(100vh-3.5rem)] lg:min-h-screen flex-1">
            <!-- Flash messages -->
            @if (TempData["Success"] != null)
            {
                <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 mt-6">
                    <div class="rounded-md bg-emerald-50 p-4 border border-emerald-200">
                        <p class="text-sm font-medium text-emerald-800">@TempData["Success"]</p>
                    </div>
                </div>
            }

            <main class="flex-1 py-8">
                <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
                    @RenderBody()
                </div>
            </main>

            <footer class="border-t border-slate-200 bg-white">
                <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
                    <p class="text-center text-sm text-slate-500">&copy; 2026 - Online Banking Management System</p>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_LogoutModal" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>