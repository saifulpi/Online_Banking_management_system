@model BankingActionViewModel
@{
    ViewData["Title"] = "Deposit Money";
    var accounts = ViewBag.Accounts as List<Account> ?? new List<Account>();
    var isAdmin = User.IsInRole("Admin");
    var currentBalance = (decimal?)ViewBag.CurrentBalance;
    if (!isAdmin) { Layout = "_DashboardLayout"; }

    string AmountFormatted(decimal? value) => value?.ToString("C") ?? "-";
}

<div class="mx-auto w-full max-w-xl">
    <!-- Page header -->
    <header class="mb-6">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Deposit Money</h1>
        <p class="mt-1 text-sm text-slate-600">Add money to your bank account securely.</p>
    </header>

    <!-- Form card -->
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <form asp-action="Deposit" method="post" class="p-6 sm:p-8" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="mb-6 flex items-start gap-3 rounded-md border border-red-200 bg-red-50 p-4">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
                    </svg>
                    <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                </div>
            }

            <div class="space-y-6">
                <!-- Account -->
                <div>
                    <label asp-for="AccountNumber" class="block text-sm font-medium text-slate-700">Account Number</label>
                    <div class="mt-1.5">
                        @if (isAdmin)
                        {
                            <input asp-for="AccountNumber" list="accounts-list" autocomplete="off"
                                   class="block w-full rounded-md border-slate-300 px-3 py-2.5 text-base text-slate-900 shadow-sm focus:border-emerald-600 focus:ring-emerald-600 sm:text-sm" />
                            <datalist id="accounts-list">
                                @foreach (var account in accounts)
                                {
                                    <option value="@account.AccountNumber">@account.Name</option>
                                }
                            </datalist>
                        }
                        else
                        {
                            <input asp-for="AccountNumber" readonly
                                   class="block w-full rounded-md border-slate-200 bg-slate-50 px-3 py-2.5 text-base font-medium text-slate-700 sm:text-sm" />
                            <p class="mt-1.5 text-xs text-slate-500">You can only deposit into your own account.</p>
                        }
                    </div>
                    <span asp-validation-for="AccountNumber" class="text-xs text-red-600"></span>
                </div>

                <!-- Amount -->
                <div>
                    <label asp-for="Amount" class="block text-sm font-medium text-slate-700">Amount</label>
                    <div class="relative mt-1.5">
                        <input asp-for="Amount" type="number" step="0.01" min="0.01" placeholder="0.00"
                               class="block w-full rounded-md border-slate-300 px-3 pl-8 py-2.5 text-base text-slate-900 shadow-sm focus:border-emerald-600 focus:ring-emerald-600 sm:text-sm" />
                        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">৳</span>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Enter the amount you want to deposit.</p>
                    <span asp-validation-for="Amount" class="text-xs text-red-600"></span>
                </div>

                @if (!isAdmin)
                {
                    <!-- Re-authentication -->
                    <div class="rounded-md border border-emerald-100 bg-emerald-50 p-4">
                        <label asp-for="Password" class="block text-sm font-medium text-slate-700">Enter Your Password</label>
                        <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••"
                               class="mt-1.5 block w-full rounded-md border-slate-300 px-3 py-2.5 text-base text-slate-900 shadow-sm focus:border-emerald-600 focus:ring-emerald-600 sm:text-sm" />
                        <p class="mt-1.5 text-xs text-slate-500">Enter your account password to authorize this deposit.</p>
                        <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                    </div>
                }

                <!-- Actions -->
                <div class="flex flex-col-reverse items-stretch gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
                    <a asp-controller="Home" asp-action="Index"
                       class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
                        Cancel
                    </a>
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700">
                        Deposit Money
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Information card -->
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h2 class="text-sm font-semibold text-slate-900">Deposit Information</h2>
        </div>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                Deposits are added to your current balance (@AmountFormatted(currentBalance)).
            </li>
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                Make sure the amount is correct before continuing.
            </li>
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                A transaction record will be created after a successful deposit.
            </li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}