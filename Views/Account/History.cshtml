@model List<Transaction>
@{
    ViewData["Title"] = "Transaction History";
    var accounts = ViewBag.Accounts as List<Account> ?? new List<Account>();
    var selectedAccount = ViewBag.AccountNumber as string;
    var isAdmin = User.IsInRole("Admin");
    if (!isAdmin) { Layout = "_DashboardLayout"; }
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Transaction History</h1>
        <p class="mt-1 text-sm text-slate-600">
            @if (isAdmin)
            {
                <text>View transaction records for any account.</text>
            }
            else
            {
                <text>Showing records for account <span class="font-semibold">@selectedAccount</span>.</text>
            }
        </p>
    </div>

    @if (isAdmin)
    {
        <form method="get" class="rounded-lg bg-white p-4 shadow">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-slate-700">Select Account</label>
                    <select name="accountNumber" class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm">
                        <option value="">-- All accounts / select to filter --</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.AccountNumber" selected="@(selectedAccount == account.AccountNumber)">
                                @account.AccountNumber - @account.Name
                            </option>
                        }
                    </select>
                </div>
                <button type="submit"
                        class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700">
                    View History
                </button>
            </div>
        </form>
    }

    @if (Model.Any())
    {
        <div class="overflow-hidden rounded-lg bg-white shadow">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date</th>
                        @if (isAdmin)
                        {
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account</th>
                        }
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Related</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Amount</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Balance After</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Note</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var t in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 text-sm text-slate-600 whitespace-nowrap">@t.Date.ToLocalTime().ToDisplayDateTime()</td>
                            @if (isAdmin)
                            {
                                <td class="px-4 py-3 text-sm font-medium text-slate-900">@t.AccountNumber</td>
                            }
                            <td class="px-4 py-3">
                                @if (t.Type == TransactionType.Deposit)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700">Deposit</span>
                                }
                                else if (t.Type == TransactionType.Withdrawal)
                                {
                                    <span class="inline-flex rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-700">Withdrawal</span>
                                }
                                else
                                {
                                    var received = t.Note.StartsWith("Received", StringComparison.OrdinalIgnoreCase);
                                    <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold @(received ? "bg-teal-100 text-teal-700" : "bg-indigo-100 text-indigo-700")">
                                        @(received ? "Transfer In" : "Transfer Out")
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-700">@(t.RelatedAccountNumber ?? "-")</td>
                            <td class="px-4 py-3 text-right text-sm font-semibold text-slate-900">@t.Amount.ToString("C")</td>
                            <td class="px-4 py-3 text-right text-sm text-slate-700">@t.BalanceAfter.ToString("C")</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium
                                    @(t.Status == "Completed" ? "bg-green-100 text-green-700" : "bg-amber-100 text-amber-700")">
                                    @t.Status
                                </span>
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-600">@t.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="rounded-lg bg-white p-10 text-center shadow">
            @if (isAdmin && string.IsNullOrEmpty(selectedAccount))
            {
                <p class="text-slate-600">Select an account above to view its transaction history.</p>
            }
            else
            {
                <p class="text-slate-600">No transactions found for this account.</p>
            }
        </div>
    }
</div>