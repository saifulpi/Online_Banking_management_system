@model BankingActionViewModel
@{
    ViewData["Title"] = "Withdraw Money";
    var accounts = ViewBag.Accounts as List<Account> ?? new List<Account>();
    var isAdmin = User.IsInRole("Admin");
    var currentBalance = (decimal?)ViewBag.CurrentBalance;
    if (!isAdmin) { Layout = "_DashboardLayout"; }

    string AmountFormatted(decimal? value) => value?.ToString("C") ?? "-";
}

<div class="mx-auto w-full max-w-xl">
    <!-- Page header -->
    <header class="mb-6">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Withdraw Money</h1>
        <p class="mt-1 text-sm text-slate-600">Withdraw money from your bank account.</p>
        <p class="mt-2 text-xs text-slate-500">Note: A per-transaction withdrawal limit applies, with a maximum of 10 withdrawals per day.</p>
    </header>

    <!-- Form card -->
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <!-- Balance banner -->
        <div class="border-b border-slate-200 bg-slate-50 px-6 py-5 sm:px-8">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Current Balance</p>
            <p class="mt-1 text-3xl font-bold text-slate-900">@AmountFormatted(currentBalance)</p>
        </div>

        <form id="withdrawForm" asp-action="Withdraw" method="post" class="p-6 sm:p-8" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="mb-6 flex items-start gap-3 rounded-md border border-red-200 bg-red-50 p-4">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
                    </svg>
                    <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                </div>
            }

            <div class="space-y-6">
                <!-- Account (hidden from user, shown as read-only) -->
                <div>
                    <label asp-for="AccountNumber" class="block text-sm font-medium text-slate-700">Account Number</label>
                    <div class="mt-1.5">
                        @if (isAdmin)
                        {
                            <input asp-for="AccountNumber" list="accounts-list" autocomplete="off"
                                   class="block w-full rounded-md border-slate-300 px-3 py-2.5 text-base text-slate-900 shadow-sm focus:border-amber-600 focus:ring-amber-600 sm:text-sm" />
                            <datalist id="accounts-list">
                                @foreach (var account in accounts)
                                {
                                    <option value="@account.AccountNumber">@account.Name</option>
                                }
                            </datalist>
                        }
                        else
                        {
                            <input asp-for="AccountNumber" readonly
                                   class="block w-full rounded-md border-slate-200 bg-slate-50 px-3 py-2.5 text-base font-medium text-slate-700 sm:text-sm" />
                            <p class="mt-1.5 text-xs text-slate-500">You can only withdraw from your own account.</p>
                        }
                    </div>
                    <span asp-validation-for="AccountNumber" class="text-xs text-red-600"></span>
                </div>

                <!-- Amount -->
                <div>
                    <label asp-for="Amount" class="block text-sm font-medium text-slate-700">Amount</label>
                    <div class="relative mt-1.5">
                        <input asp-for="Amount" type="number" step="0.01" min="100" value="" placeholder="Enter amount"
                               class="block w-full rounded-md border-slate-300 px-3 pl-8 py-2.5 text-base text-slate-900 shadow-sm focus:border-amber-600 focus:ring-amber-600 sm:text-sm" />
                        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">৳</span>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Enter the amount you want to withdraw (minimum ৳100).</p>
                    <span asp-validation-for="Amount" class="text-xs text-red-600"></span>
                </div>

                <!-- Actions -->
                <div class="flex flex-col-reverse items-stretch gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
                    <a asp-controller="Home" asp-action="Index"
                       class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
                        Cancel
                    </a>
                    <button type="submit" id="withdrawSubmitBtn"
                            class="inline-flex items-center justify-center rounded-md bg-amber-500 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-600">
                        Withdraw Money
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Information card -->
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h2 class="text-sm font-semibold text-slate-900">Withdrawal Information</h2>
        </div>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
                You can withdraw only from your own account.
            </li>
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
                Make sure you have sufficient balance.
            </li>
            <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
                A transaction record will be created after a successful withdrawal.
            </li>
        </ul>
    </div>
</div>

<!-- Confirmation modal -->
<div id="withdrawModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/50" onclick="closeWithdrawModal()"></div>
    <div class="relative w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
        <div class="flex items-start gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-red-100">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                </svg>
            </div>
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-slate-900">Confirm Withdrawal</h2>
                <p class="mt-1 text-sm text-slate-600">
                    Withdraw <span id="modalAmount" class="font-semibold text-slate-900">৳0.00</span>
                    from account <span id="modalAccount" class="font-semibold text-slate-900">—</span>?
                </p>
                <p class="mt-2 text-sm font-medium text-red-600">This cannot be undone.</p>

                @if (!isAdmin)
                {
                    <div class="mt-4">
                        <label asp-for="Password" class="block text-sm font-medium text-slate-700">Enter Your Password</label>
                        <input asp-for="Password" type="password" form="withdrawForm" autocomplete="current-password" placeholder="••••••••"
                               class="mt-1.5 block w-full rounded-md border-slate-300 px-3 py-2.5 text-base text-slate-900 shadow-sm focus:border-amber-600 focus:ring-amber-600 sm:text-sm" />
                        <p class="mt-1.5 text-xs text-slate-500">Enter your account password to authorize this withdrawal.</p>
                        <span asp-validation-for="Password" class="text-xs text-red-600"></span>
                    </div>
                }
            </div>
        </div>
        <div class="mt-6 flex items-center justify-end gap-3">
            <button type="button" onclick="closeWithdrawModal()"
                    class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Cancel
            </button>
            <button type="button" id="confirmWithdrawBtn"
                    class="rounded-md bg-amber-500 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600">
                Yes, Withdraw
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const withdrawForm = document.getElementById('withdrawForm');

        withdrawForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!withdrawForm.checkValidity()) {
                withdrawForm.reportValidity();
                return;
            }

            const raw = withdrawForm.querySelector('[name="Amount"]').value;
            const amount = (raw === '' || isNaN(raw)) ? '৳0.00' : new Intl.NumberFormat('en-US', { style: 'currency', currency: 'BDT' }).format(Number(raw));
            const account = withdrawForm.querySelector('[name="AccountNumber"]').value;
            document.getElementById('modalAmount').textContent = amount;
            document.getElementById('modalAccount').textContent = account;
            document.getElementById('withdrawModal').classList.remove('hidden');
        });

        document.getElementById('confirmWithdrawBtn').addEventListener('click', function () {
            withdrawForm.submit();
        });

        function closeWithdrawModal() {
            document.getElementById('withdrawModal').classList.add('hidden');
        }
    </script>
}