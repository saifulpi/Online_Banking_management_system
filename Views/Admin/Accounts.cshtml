@model List<Account>
@{
    ViewData["Title"] = "Account Management";
    var holderMap = (Dictionary<string, string>)ViewBag.HolderMap;

    string StatusBadge(string status)
    {
        return string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            ? "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800"
            : "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-red-100 text-red-800";
    }
}

<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Account Management</h1>
        <p class="mt-1 text-sm text-slate-600">Manage all customer bank accounts.</p>
    </div>
    <a asp-controller="Account" asp-action="Create"
       class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">+ Open New Account</a>
</div>

<div class="rounded-lg bg-white p-6 shadow">
    <form method="get" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
            <label class="block text-xs font-medium text-slate-600">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Account number, name or phone"
                   class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 text-sm shadow-sm" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-600">Status</label>
            <select name="status" class="mt-1 block w-full rounded-md border-slate-300 px-3 py-2 text-sm shadow-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Frozen" selected="@(ViewBag.Status == "Frozen")">Frozen</option>
            </select>
        </div>
        <div class="flex items-end">
            <button type="submit" class="w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
                Filter
            </button>
        </div>
    </form>

    <div class="mt-4 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account ID</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account Number</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account Holder</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Account Type</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Balance</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Created</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-4 py-8 text-center text-sm text-slate-500">No accounts found.</td>
                    </tr>
                }
                @foreach (var account in Model)
                {
                    var holder = holderMap.ContainsKey(account.AccountNumber) ? holderMap[account.AccountNumber] : account.Name;
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-sm text-slate-600">@account.Id.Substring(account.Id.Length - 8)</td>
                        <td class="px-4 py-3 text-sm font-medium text-slate-900">@account.AccountNumber</td>
                        <td class="px-4 py-3 text-sm text-slate-900">@holder</td>
                        <td class="px-4 py-3 text-sm text-slate-600">@account.AccountType</td>
                        <td class="px-4 py-3 text-right text-sm font-semibold text-slate-900">@account.Balance.ToString("C")</td>
                        <td class="px-4 py-3"><span class="@(StatusBadge(account.Status))">@account.Status</span></td>
                        <td class="px-4 py-3 text-sm text-slate-600">@account.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center space-x-2">
                                <a asp-controller="Admin" asp-action="AccountDetails" asp-route-accountNumber="@account.AccountNumber"
                                   class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200">View</a>
                                <a asp-controller="Admin" asp-action="Transactions" asp-route-accountNumber="@account.AccountNumber"
                                   class="rounded-md bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 hover:bg-indigo-100">Transactions</a>
                                @if (account.Status == "Active")
                                {
                                    <form asp-controller="Admin" asp-action="FreezeAccount" asp-route-accountNumber="@account.AccountNumber" method="post"
                                          class="user-action-form inline" data-action="freeze" data-user-name="@account.AccountNumber">
                                        <button type="submit" class="rounded-md bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 hover:bg-red-100">Freeze</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="ActivateAccount" asp-route-accountNumber="@account.AccountNumber" method="post"
                                          class="user-action-form inline" data-action="activate-account" data-user-name="@account.AccountNumber">
                                        <button type="submit" class="rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-100">Activate</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" />
</div>

<partial name="_ConfirmUserActionModal" />