@model List<Transaction>
@{
    ViewData["Title"] = "Transaction Management";
    ViewBag.SectionTitle = "Transaction Management";
    ViewBag.ShowBalances = true;
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">Transaction Management</h1>
    <p class="mt-1 text-sm text-slate-600">Centralized audit trail of all financial transactions.</p>
</div>

<div class="rounded-lg bg-white p-6 shadow">
    <partial name="_TransactionFilters" />
    <partial name="_TransactionTable" model="Model" />
    <partial name="_Pagination" />
</div>